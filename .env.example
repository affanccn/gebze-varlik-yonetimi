# =============================================================================
# GEBZE BELEDİYESİ KURUMSAL VARLIK VE KAYNAK YÖNETİM SİSTEMİ (GEBZE-EKYS)
# Ortam Değişkenleri Şablonu (.env.example)
# =============================================================================
# KULLANIM:
# 1. Bu dosyayı '.env' adıyla proje kök dizinine kopyalayın (cp .env.example .env)
# 2. Belediye Oracle veritabanı ve sunucu bilgilerini aşağıya girin.
# 3. '.env' dosyası .gitignore içindedir; ASLA git deposuna eklenmez.
# =============================================================================

# --- 1. ÇALIŞMA PROFİLİ VE SUNUCU PORTU ---
# Üretim ortamında 'prod', geliştirme ortamında 'dev' kullanın.
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# --- 2. ORACLE VERİTABANI BAĞLANTI BİLGİLERİ (UYGULAMA ÇALIŞMA ZAMANI - DML) ---
# Seçenek A: Service Name ile Bağlantı (Önerilen - Oracle 19c / 21c / 23ai)
DB_HOST=10.10.0.50
DB_PORT=1521
DB_SERVICE=GEBZEPDB
DB_URL=jdbc:oracle:thin:@//10.10.0.50:1521/GEBZEPDB

# Seçenek B: Klasik Oracle SID ile Bağlantı (Gerekirse DB_URL satırını bununla değiştirin)
# DB_SID=ORCL
# DB_URL=jdbc:oracle:thin:@10.10.0.50:1521:ORCL

# Seçenek C: Oracle Wallet / TCPS (TLS Şifreli) Bağlantı (Gerekirse)
# DB_WALLET_DIR=/opt/gebze-varlik/wallet
# DB_URL=jdbc:oracle:thin:@gebze_varlik_high?TNS_ADMIN=/opt/gebze-varlik/wallet

# Uygulama Çalışma Zamanı Kullanıcısı (Sadece SELECT, INSERT, UPDATE, DELETE yetkili)
DB_USER=varlik_app_runtime
DB_PASSWORD=BURAYA_GUCLU_DB_SIFRESI_GIRINIZ

# Şema sahibi farklı bir kullanıcı ise (örn. VARLIK_OWNER) şema adını belirtin:
DB_SCHEMA=VARLIK_OWNER

# --- 3. FLYWAY MİGRASYON KULLANICISI (DDL YETKİLİ ŞEMA SAHİBİ) ---
# Bağlantı gününde tabloları ve indeksleri oluşturacak DDL yetkili kullanıcı.
# Not: Şema kurulduktan sonra üretimde DB_MIGRATION_ENABLED=false yapılabilir veya
#      FLYWAY_USER ile sadece başlangıçta migrasyon koşturulabilir.
DB_MIGRATION_ENABLED=true
DB_MIGRATION_LOCATIONS=classpath:db/migration-prod
FLYWAY_URL=jdbc:oracle:thin:@//10.10.0.50:1521/GEBZEPDB
FLYWAY_USER=varlik_owner
FLYWAY_PASSWORD=BURAYA_DDL_SAHIBI_SIFRESI_GIRINIZ

# --- 4. HIKARICP BAĞLANTI HAVUZU VE ZAMAN AŞIMI AYARLARI ---
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=5
DB_CONNECTION_TIMEOUT_MS=30000
DB_IDLE_TIMEOUT_MS=600000
DB_MAX_LIFETIME_MS=1800000
DB_CONNECT_TIMEOUT_MS=10000
DB_READ_TIMEOUT_MS=30000
DB_INIT_FAIL_TIMEOUT=30000

# --- 5. İLK SİSTEM YÖNETİCİSİ (BOOTSTRAP ADMIN) ---
# Sistemde hiç ADMIN yokken ilk açılışta otomatik oluşturulur (must_change_password=1).
# İlk girişte şifre değiştirilmesi zorunludur.
APP_ADMIN_USERNAME=admin
APP_ADMIN_EMAIL=bilgiislem@gebze.bel.tr
APP_ADMIN_PASSWORD=BURAYA_ILK_ADMIN_GECICI_SIFRESI_GIRINIZ

# --- 6. GÜVENLİK VE OTURUM ÇEREZLERİ ---
# HTTPS (Reverse Proxy / Nginx / IIS) arkasında çalışırken true olmalıdır.
SESSION_COOKIE_SECURE=true
COOKIE_SECURE=true
SECURITY_HSTS_ENABLED=true
